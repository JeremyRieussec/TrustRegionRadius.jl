@article{BollByrdNoce18IMA,
  title     = {Exact and inexact subsampled {N}ewton methods for optimization},
  author    = {Bollapragada, Raghu and Byrd, Richard H. and Nocedal, Jorge},
  year      = 2018,
  journal   = {IMA Journal of Numerical Analysis},
