@article{CartGoulToin09,
  title    = {Trust-region and other regularisations of linear least-squares problems},
  volume   = {49},
  optissn  = {1572-9125},
  doi      = {10.1007/s10543-008-0206-8},
  abstract = {We consider methods for regularising the least-squares solution of the linear system Ax=b. In particular, we propose iterative methods for solving large problems in which a trust-region bound ‖x‖≤Δ is imposed on the size of the solution, and in which the least value of linear combinations of ‖Ax−b‖2qand a regularisation term ‖x‖2pfor various p and q=1,2 is sought. In each case, one or more “secular” equations are derived, and fast Newton-like solution procedures are suggested. The resulting algorithms are available as part of the \${\textbackslash}mathsf\{G\}\$ALAHAD optimization library.},
  number   = {1},
  journal  = {BIT Numerical Mathematics},
  author   = {Cartis, Coralia and Gould, Nicholas I. M. and Toint, {Ph}ilippe L.},
  optmonth    = mar,
  year     = {2009},
  pages    = {21--53}
}

@article{CartGoulToin10,
  title    = {On the Complexity of Steepest Descent, {N}ewton's and Regularized {N}ewton's Methods for Nonconvex Unconstrained Optimization Problems},
  volume   = {20},
  doi      = {10.1137/090774100},
  abstract = {It is shown that the steepest-descent and Newton's methods for unconstrained nonconvex optimization under standard assumptions may both require a number of iterations and function evaluations arbitrarily close to {\textbackslash}O({\textbackslash}epsilon{\textasciicircum}-2){\textbackslash} to drive the norm of the gradient below {\textbackslash}epsilon{\textbackslash}. This shows that the upper bound of {\textbackslash}O({\textbackslash}epsilon{\textasciicircum}-2){\textbackslash} evaluations known for the steepest descent is tight and that Newton's method may be as slow as the steepest-descent method in the worst case. The improved evaluation complexity bound of {\textbackslash}O({\textbackslash}epsilon{\textasciicircum}-3/2){\textbackslash} evaluations known for cubically regularized Newton's methods is also shown to be tight.},
  number   = {6},
  journal  = {SIAM Journal on Optimization},
  author   = {Cartis, Coralia and Gould, Nicholas I. M. and Toint, {Ph}ilippe L.},
  year     = {2010},
  pages    = {2833--2852}
}

