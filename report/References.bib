@article{BirgGardMartSantToin17,
	title = {Worst-case evaluation complexity for unconstrained nonlinear optimization using high-order regularized models},
	volume = {163},
	optissn = {1436-4646},
	doi = {10.1007/s10107-016-1065-8},
	abstract = {The worst-case evaluation complexity for smooth (possibly nonconvex) unconstrained optimization is considered. It is shown that, if one is willing to use derivatives of the objective function up to order p (for \$\$p{\textbackslash}ge 1\$\$) and to assume Lipschitz continuity of the p-th derivative, then an \$\${\textbackslash}epsilon \$\$-approximate first-order critical point can be computed in at most \$\$O({\textbackslash}epsilon {\textasciicircum}\{-(p+1)/p\})\$\$evaluations of the problem’s objective function and its derivatives. This generalizes and subsumes results known for \$\$p=1\$\$and \$\$p=2\$\$.},
	number = {1},
	journal = {Mathematical Programming},
	author = {Birgin, E. G. and Gardenghi, J. L. and Martínez, J. M. and Santos, S. A. and Toint, Ph. L.},
	optmonth = may,
	year = {2017},
	pages = {359--368},
}

@inbook{BoydVandenberghe04,
